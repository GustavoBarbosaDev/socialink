# Chave secreta para assinatura de tokens JWT
# Gere uma chave forte e aleatória (ex: openssl rand -hex 32)
SECRET_KEY=sua_chave_secreta_aqui

# URL do banco de dados
# SQLite (padrão para desenvolvimento)
DATABASE_URL=sqlite:///./socialink.db
# PostgreSQL (produção)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/socialink

# Algoritmo de assinatura JWT (não alterar)
JWT_ALGORITHM=HS256

# Tempo de expiração do token JWT em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30
